# Prisma Postgres connection string. Keep the real connection string private.
DATABASE_URL="postgres://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require"

# Generate a unique random value of at least 32 characters for each environment.
ADMIN_JWT_SECRET="replace-with-a-random-secret-of-at-least-32-characters"

# Set these only when provisioning an administrator; remove ADMIN_PASSWORD afterward.
# ADMIN_EMAIL="admin@example.org"
# ADMIN_NAME="Club Administrator"
# ADMIN_PASSWORD="replace-with-a-unique-password"
# ADMIN_ROLE="OWNER"

# Resend is required for account invitations and password reset emails.
# Optional contact notifications also use the Resend API key.
# RESEND_API_KEY="re_..."
# CONTACT_FROM_EMAIL="BITPeSports <club@example.org>"
# CONTACT_TO_EMAIL="club@example.org"
# AUTH_FROM_EMAIL="BITPeSports <club@example.org>"
# APP_BASE_URL="https://your-public-site.example.org"
